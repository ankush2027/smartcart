{
  "rules": {
    ".read": false,
    ".write": false,
    "products": {
      ".read": "auth != null && auth.token.role === 'manager'",
      ".write": false
    },
    "sessions": {
      ".read": "auth != null && (auth.token.role === 'manager' || (query.orderByChild === 'customer_uid' && query.equalTo === auth.uid))",
      ".write": false,
      "$session_id": {
        ".read": "auth != null && (auth.token.role === 'manager' || data.child('customer_uid').val() === auth.uid)",
        ".write": false
      },
      ".indexOn": [
        "customer_uid"
      ]
    }
  }
}
