FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /srv/smartcart
COPY requirements-cloud.txt ./
RUN pip install --no-cache-dir -r requirements-cloud.txt && useradd --uid 10001 --create-home smartcart
COPY edge/ ./edge/
RUN mkdir /var/data && chown smartcart:smartcart /var/data
USER smartcart
EXPOSE 10000
CMD ["python", "-m", "edge.cloud.run"]
